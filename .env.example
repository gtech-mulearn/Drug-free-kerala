# Copy to .env.local (gitignored) and uncomment what you need.
# Production sets none of these: unset or empty means the real µLearn APIs.
# Only the Next.js server reads them; the browser never calls these hosts.

# Campaign API: pledges, certificate lookup and the pledge total.
# Default: https://mulearn.org/api/v1/drugfreekerala/
#
# The local backend (drugfreekerala-backend, `uvicorn app:application --env-file .env --port 5001`).
# Pledges then go to your dev database instead of production:
# MULEARN_API_BASE_URL=http://127.0.0.1:5001/api/v1/drugfreekerala/
#
# Or the e2e mock (`node e2e/mock-upstream.mjs`):
# MULEARN_API_BASE_URL=http://127.0.0.1:4010/

# µLearn's registration API, used only for the college list in the pledge form.
# It is public and read-only, so the default is fine for local development.
# Default: https://mulearn.org/api/v1/register/
# MULEARN_REGISTER_API_BASE_URL=http://127.0.0.1:4010/register/
